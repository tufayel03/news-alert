{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-alert",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/3 * * * *"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
