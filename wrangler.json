{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forex-ai-news-alert",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/3 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "NEWS_KV",
      "id": "forex_news_kv_placeholder"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
